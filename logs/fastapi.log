{"level": "INFO", "app_name": "fastapi", "file_name": "pipeline_orchestrator_sdk.py", "request_route": "-", "func_name": "process_query", "message": "[STAGE 8] SQL Query:\nSELECT r.\"id\", r.\"name\", r.\"ingress\", r.\"image\", (r.\"prepTime\" + r.\"cookTime\") as total_time, r.\"difficulty\", r.\"servings\"\nFROM recipe r\nLEFT JOIN bundle_recipe br ON r.\"id\" = br.\"recipeId\" AND br.\"deletedAt\" IS NULL\nLEFT JOIN \"bundle\" b ON br.\"bundleId\" = b.\"id\"\nLEFT JOIN user_likes_recipe ulr ON r.\"id\" = ulr.\"recipeId\" AND ulr.\"userUid\" = 'ZJktg0EIvQat783fdpjWiWXCxsS2'\nWHERE r.\"deletedAt\" IS NULL\n  AND r.\"status\" = 'published'\n  AND r.\"languageId\" = 'en'\n  AND (r.\"private\" = false OR r.\"userUid\" = 'ZJktg0EIvQat783fdpjWiWXCxsS2' OR br.\"bundleId\" IS NOT NULL)\n  AND r.\"id\" IN ('5f9113e7-c724-45e0-a65f-aeb8b656a7b5', '27a5b101-5483-42b1-ad94-046137e7b309', 'b338bab8-70d3-479c-bf24-99ba339c32f5', '00737978-8f98-47e7-b727-162080577683', '94d2c528-0ae3-4f48-8c6d-e9a17f06bdc1', 'c0c327e1-ca74-4dfc-b664-365cad968350', '3715c09a-3f59-47a1-91c2-dd236298f8b4', '16b994a7-aa06-4702-be68-dee784f65c8f', 'c73d6e1f-5de3-428e-a155-b804c254bb75', 'dba368a0-e339-4f26-92ce-08b774f6c1a4', '0e3db135-849a-4930-9975-8bde4d778dbf', '21e8548a-4988-4efa-b406-eeea0d873669', '0ddc6d9a-bf4e-412d-a4a6-720ac27b60e9', 'e6a5cb60-1c7e-4146-b9eb-30bcd8885f95', '9e88e624-080a-4a5b-8806-4a516fa85f7c')\n  AND (\n    r.\"name\" ILIKE '%chole%'\n    OR EXISTS (\n      SELECT 1\n      FROM recipe_ingredient ri\n      JOIN ingredient i ON ri.\"ingredientId\" = i.\"id\"\n      WHERE ri.\"recipeId\" = r.\"id\"\n        AND i.\"name\" ILIKE '%chole%'\n    )\n  )\nLIMIT 20"}
