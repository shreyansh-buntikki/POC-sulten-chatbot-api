{"level": "INFO", "app_name": "fastapi", "file_name": "pipeline_orchestrator_sdk.py", "request_route": "-", "func_name": "_handle_filter_refinement", "message": "[FILTER REFINEMENT] Executing SQL:\n\n        SELECT r.id, r.name, r.ingress,\n               r.difficulty, r.\"prepTime\" as prep_time, r.\"cookTime\" as cook_time,\n               r.image, r.servings, r.\"userUid\" as creator_uid,\n               r.\"private\", r.\"deletedAt\", r.recipe_metadata,\n               CAST(r.\"recipe_metadata\"->'pricing'->'norway'->>'total' AS FLOAT) as _cost_sort\n        FROM recipe r\n        LEFT JOIN bundle_recipe br ON r.\"id\" = br.\"recipeId\" AND br.\"deletedAt\" IS NULL\n        LEFT JOIN \"bundle\" b ON br.\"bundleId\" = b.\"id\"\n        WHERE r.id IN ('c8dd74bb-284d-4110-98f0-93a816713cdc', '7cf1f0dd-da1b-4cf1-b343-8b3b8c08be68', 'ac3e81de-c780-40c7-8ffc-590ec4218eab', '73efa94f-07fe-486b-8c55-7f00a896104c', 'be3a92b3-9c6b-423e-bcaf-486de7a43a68', '976dc768-7de1-48dd-a873-3fe33492d351', '5d5db744-988f-40fa-b437-f8f493d025e3', 'da27d8e6-fcd1-4cac-9a2a-39928148804e', '02e76d56-671d-4391-bb48-5421881a2a30', '44571047-53f9-4d48-b2cd-37ecda3b062e', '038701d8-03e5-428e-9dde-21a1480e1a90', 'f846956f-21d0-42bb-be21-91f94a1d0519', '462b483c-c39b-4ed2-bf5a-4dfcf3f0fc26', 'a1e199ca-12bf-4844-9650-8ce53f728b5f', '6dd70782-0d7e-4294-a302-eb9f01c66b79', '9da52e0a-63c5-4787-b0f5-f7070d18cf60', '90144538-edc6-4c98-b5ed-584d379fe08e', '6eec4148-860a-4303-91cc-6640f013bf79', '0ae17c82-9f51-4a0f-884d-2d111a9dd85b', 'ab9ca76e-1493-462a-afcf-b7847dccd88a')\n          AND r.\"deletedAt\" IS NULL\n          AND r.\"status\" = 'published'\n          AND r.\"languageId\" = 'en'\n          AND (r.\"private\" = false OR r.\"userUid\" = 'ZJktg0EIvQat783fdpjWiWXCxsS2' OR br.\"bundleId\" IS NOT NULL)\n          \n            AND r.\"recipe_metadata\" IS NOT NULL\n            AND r.\"recipe_metadata\"->'pricing' IS NOT NULL\n            AND r.\"recipe_metadata\"->'pricing'->'norway' IS NOT NULL\n            AND r.\"recipe_metadata\"->'pricing'->'norway'->>'total' IS NOT NULL\n            \n            AND CAST(r.\"recipe_metadata\"->'pricing'->'norway'->>'total' AS FLOAT) <= 800\n            \n          \n          \n          \n          AND EXISTS (\n              SELECT 1 FROM recipe_tags_tag rtt\n              JOIN tag t ON rtt.\"tagId\" = t.\"id\"\n              WHERE rtt.\"recipeId\" = r.\"id\"\n              AND LOWER(t.\"name\") IN ('italian')\n          )\n          AND r.servings = 2\n        ORDER BY _cost_sort DESC\n        LIMIT 20\n        "}
