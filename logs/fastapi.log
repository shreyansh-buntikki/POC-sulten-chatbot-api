{"level": "INFO", "app_name": "fastapi", "file_name": "pipeline_orchestrator_sdk.py", "request_route": "-", "func_name": "_handle_filter_query", "message": "SQL QUERY: \nSELECT r.\"id\", r.\"name\", r.\"ingress\", r.\"image\",\n       (r.\"prepTime\" + r.\"cookTime\") as total_time,\n       r.\"difficulty\", r.\"servings\",\n       r.\"recipe_metadata\"\nFROM recipe r\nLEFT JOIN bundle_recipe br ON r.\"id\" = br.\"recipeId\" AND br.\"deletedAt\" IS NULL\nLEFT JOIN \"bundle\" b ON br.\"bundleId\" = b.\"id\"\nWHERE r.\"deletedAt\" IS NULL\n  AND r.\"status\" = 'published'\n  AND r.\"languageId\" = 'en'\n  AND (r.\"private\" = false OR r.\"userUid\" = '7dWNXkB9zZZBy37qgkysX7ayM0a2' OR br.\"bundleId\" IS NOT NULL)\n  AND r.\"recipe_metadata\" IS NOT NULL\n  AND r.\"recipe_metadata\"->'pricing' IS NOT NULL\n  AND r.\"recipe_metadata\"->'pricing'->'norway' IS NOT NULL\n  AND r.\"recipe_metadata\"->'pricing'->'norway'->>'total' IS NOT NULL\n  AND r.servings = 2\n\nORDER BY CAST(r.\"recipe_metadata\"->'pricing'->'norway'->>'total' AS FLOAT) ASC\nLIMIT 100\n"}
